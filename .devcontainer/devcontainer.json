{
  "name": "Forager DevContainer",

  "image": "mcr.microsoft.com/devcontainers/base:debian",
  // No workspaceFolder or workspaceMount: the default, /workspaces/<directory name>, keeps each
  // project under a path of its own, and an agent keys its memory by the path (as NUC v0.7.0
  // mounts it). A path every project shares gives every project one agent memory.

  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // The host's agent config directory. HOME is set on Linux and macOS, USERPROFILE on Windows;
  // exactly one of the two is non-empty, so concatenating both yields the home directory on every
  // host (the pattern the Dev Containers documentation recommends).
  // And gh's login, in a host directory of its own, so that one login outlives every rebuild
  // (ADR-0042); not the host's own ~/.config/gh, whose token may sit in a keyring.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh-devcontainer,target=/home/vscode/.config/gh,type=bind"
  ],

  "shutdownAction": "stopContainer",

  // Runs on the host before the container is created. Ensures the bind-mount source for the agent
  // config exists, so Docker does not auto-create it as a root-owned directory (which breaks
  // credential writes inside the container). Written to work in both a POSIX shell and cmd.exe:
  // plain `mkdir` (cmd.exe knows no `-p`; the parent is the home directory and always exists) and
  // `|| exit 0` so an already existing directory — an error for both shells — does not abort the
  // container build.
  // The same holds for gh's directory (ADR-0042); its parent .config may be missing, which
  // `mkdir -p` creates in a POSIX shell, and which cmd.exe leaves to be created once by hand.
  // The object form runs the two side by side.
  "initializeCommand": {
    "claude": "mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\" || exit 0",
    "gh": "mkdir -p \"${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh-devcontainer\" || exit 0"
  },

  // Runs inside the container once it is created. Git does not version its hooks, so the
  // repository keeps them under .githooks/ and this points git at them: pre-commit refuses a
  // commit on main (AGENTS.md, section 6), pre-push runs the checks first (AGENTS.md, section 5).
  // Outside the container, run the same command once per clone (README → "Getting Started").
  // ShellCheck comes from the base image's signed Debian archive, so the pre-push hook runs the
  // shell lint CI runs; without it the lint skips itself locally.
  "postCreateCommand": {
    "hooks": "git config core.hooksPath .githooks",
    // The merge driver of the ADR index, which .gitattributes names (.githooks/merge-adr-index).
    "adr-index": "git config merge.adr-index.driver '.githooks/merge-adr-index %O %A %B %S %X %Y'",
    "shellcheck": "sudo apt-get update && sudo apt-get install -y --no-install-recommends shellcheck",
    // The pinned toolchain, cargo-deny, and the wasm-bindgen CLI (ADR-0008, ADR-0010).
    "tools": "bash scripts/install-tools.sh",
    // git authenticates through gh's stored login, not through VS Code's helper of an earlier
    // container (ADR-0042); before the first login it has nothing to set up.
    "gh-git": "gh auth setup-git || true"
  },

  // DevContainer Features layered on top of the base image. The container intentionally has NO
  // access to the host Docker daemon (no socket mount) — see ADR-0004. Manage the host's containers
  // from a host-side VS Code extension instead (README → "Host container management").
  "features": {
    // GitHub CLI (`gh`) — used by the coding agent for GitHub operations and as the git
    // credential helper. A push and every gh action wait for a human instruction
    // (AGENTS.md, section 6).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // rustup, which installs the toolchain rust-toolchain.toml pins (ADR-0010). The Feature also
    // installs the latest stable, which the pin overrides.
    "ghcr.io/devcontainers/features/rust:1": {}
  },

  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  },

  "forwardPorts": [],

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
